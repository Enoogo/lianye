+          fail_on_unmatched_files: true
+          files: |
+            Lianye-${{ env.RELEASE_TAG }}.apk
+            SHA256SUMS.txt
+        env:
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+
+  deploy-fdroid-repo:
+    name: Deploy F-Droid Repository
+    needs: build-and-release
+    if: github.event_name != 'workflow_dispatch' || inputs.publish
+    permissions:
