+
+    private fun makeDraggable(handle: View) {
+        var startX = 0f
+        var startY = 0f
+        var baseX = 0f
+        var baseY = 0f
+        handle.setOnTouchListener { _, event ->
+            when (event.actionMasked) {
+                MotionEvent.ACTION_DOWN -> {
