+name: Release
+
+on:
+  push:
+    tags:
+      - 'v*'
+  workflow_dispatch:
+    inputs:
+      release_tag:
+        description: 'Existing version tag to build and publish'
+        required: true
+        type: string
+      publish:
+        description: 'Publish the release and deploy F-Droid after verification'
+        required: true
+        default: true
+        type: boolean
+
+permissions:
+  contents: write
+
+env:
+  RELEASE_TAG: ${{ inputs.release_tag || github.ref_name }}
+
+jobs:
+  build-and-release:
+    name: Build and verify signed APK
+    runs-on: ubuntu-24.04
+
+    steps:
+      - name: Checkout source
+        uses: actions/checkout@v7.0.1
+        with:
+          ref: ${{ env.RELEASE_TAG }}
+
+      - name: Checkout release verification tools
+        uses: actions/checkout@v7.0.1
+        with:
+          ref: ${{ github.workflow_sha }}
+          path: .release-tools
+          sparse-checkout: tool
+
+      - name: Set up JDK 17
+        uses: actions/setup-java@v6.0.1
+        with:
+          java-version: '17'
+          distribution: 'temurin'
+          cache: gradle
+
+      - name: Decode Keystore
+        run: |
+          echo "${{ secrets.KEYSTORE_BASE64 }}" | base64 -d > lianye-release.jks
+
+      - name: Build signed Release APK
+        env:
+          storeFile: ${{ github.workspace }}/lianye-release.jks
+          storePassword: ${{ secrets.KEYSTORE_STORE_PASSWORD }}
+          keyAlias: ${{ secrets.KEYSTORE_KEY_ALIAS }}
+          keyPassword: ${{ secrets.KEYSTORE_KEY_PASSWORD }}
+        run: ./gradlew :app:testDebugUnitTest :app:lintDebug :app:assembleRelease verifyZeroNetworkDependencies
+
+      - name: Verify release identity, signature and lint
