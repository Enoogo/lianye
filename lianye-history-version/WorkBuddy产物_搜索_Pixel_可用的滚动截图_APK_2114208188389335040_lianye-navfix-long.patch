+private fun PreviewHome() {
+    LianyeTheme {
+        MainScreen(
+            uiState = MainUiState(false, true, false, RestrictedCardPhase.HIDDEN, R.string.vendor_hint_aosp),
+            onPrimaryAction = {}, onResumeDraft = {}, onNewCapture = {},
