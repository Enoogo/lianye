+                setText((snapValues[edge]?.threshold ?: RegionSnapSettings.DEFAULT_THRESHOLD).toString())
+                inputType = InputType.TYPE_CLASS_NUMBER
+                textSize = 14f
+                gravity = Gravity.CENTER
